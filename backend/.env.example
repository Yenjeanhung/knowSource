# 服务配置
HOST=0.0.0.0
PORT=8000

# 数据库
DATABASE_URL=sqlite+aiosqlite:///./data/minirag.db

# 嵌入模型配置
# EMBEDDING_PROVIDER: local (sentence-transformers 本地) 或 openai (在线 API)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMENSION=512
# 以下仅在 EMBEDDING_PROVIDER=openai 时使用
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_EMBEDDING_DIMENSION=1536

# 向量存储配置
# VECTOR_STORE_PROVIDER: chroma 或 milvus
VECTOR_STORE_PROVIDER=chroma
CHROMA_PERSIST_DIR=./data/chroma
# 以下仅在 VECTOR_STORE_PROVIDER=milvus 时使用
# MILVUS_HOST=localhost
# MILVUS_PORT=19530

# LLM 配置（支持 OpenAI / Ollama / Azure 等 OpenAI 兼容接口）
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.3·

# 文本分块
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# 文件上传
MAX_FILE_SIZE=52428800
